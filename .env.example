# ===== 循迹（Trace）配置（复制为 .env 后修改）=====

# 运行模式：lite（单机 SQLite；个人版只有这一种形态）
GA_MODE=lite

# 数据目录（lite）：存放 db / 项目工作区 / 密钥。默认 ~/.trace
GA_DATA_DIR=

# 主密钥：用于会话/令牌签名与加密
GA_SECRET_KEY=

# 数据库：本版本只用 SQLite，留空即可（文件在 GA_DATA_DIR/game_agent.db，默认 ~/.trace/game_agent.db）。
# 如需把数据库放到别处，填 sqlite+aiosqlite:///<绝对路径>；填非 SQLite 连接串会直接报错。
DATABASE_URL=

# 项目工作区根目录（所有项目 git 仓库所在）。默认 <DATA_DIR>/projects
PROJECTS_ROOT=

# 大模型：程序只调用真实大模型，没有「离线演示 / mock」模式。
# 「能不能对话」只取决于有没有配好供应商——推荐在「设置 → 模型配置」里加供应商（填地址+Key），
# 再到「设置 → 智能体」把「对话模型」绑上即可，改完即时生效、不用重启。
# 下面的 OPENAI_* 是可选的全局兜底：不想进界面配、只想用一个固定端点时用（没配供应商时才走它）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GA_LLM_MODEL=gpt-4o-mini
# 请求失败重试：额外重试次数，默认 4 → 总尝试 5 次（含首次），全部失败即放弃
# 仅在 429/5xx/超时/网络错误时重试；401/403（鉴权/额度）与其他 4xx 立即失败
# 上限固定为 5 次尝试，调大本项无效
# GA_LLM_RETRIES=4
# GA_LLM_RETRY_BASE_S=1.5
# 单次 LLM 调用硬上限（秒），防网关挂起卡死 run
# GA_LLM_CALL_TIMEOUT_S=360
# 建连超时（秒，只等 TCP+TLS 握手）：跨境端点会碰上某个 A 记录黑洞，
# 300s 建连会把它放大成五分钟白等（实测有一次 309.7s 的调用就是这么来的）。8s 足够
# GA_LLM_CONNECT_TIMEOUT_S=8
# 进程级 LLM 并发上限：主agent + 子agent 共用一把 key，挤爆中转配额只会换来 429 + 退避
# 收到 429 会自动腰斩并发、连续成功后逐步加回；0 = 不限（仅排查用）
# 实测 1~16 路并发下单请求延迟基本不变（prompt 命中缓存，瓶颈在等首 token），多开纯赚
# GA_LLM_MAX_CONCURRENCY=12
# 子agent 推理强度（档位没显式配 reasoning_effort 时生效）：none|low|medium|high|空=不干预
# 实测 sub 风格请求：不传=5.35s/537tok，none=3.62s/209tok（-32% 延迟、-61% 输出 token）
# 且子agent 的输出长尾（completion>4096 占 18% 调用、33% sub 时间）全是隐藏思考 token
# GA_SUB_REASONING_EFFORT=none
# 子agent 单次回复上限：默认 0=不设。硬截断会切碎工具调用 JSON → 整轮白扔
# GA_SUB_MAX_TOKENS=0
# 同 run 内「同工具 + 同参数」的只读调用直接复用上次结果（写/执行类工具跑过就清空）
# GA_TOOL_MEMO=true
# GA_TOOL_MEMO_MAX=200
# SQLite 落盘强度：NORMAL（WAL 下只在 checkpoint fsync，快 ~9 倍）| FULL（每事务 fsync）
# GA_SQLITE_SYNC=NORMAL
# 是否显式声明「一轮可以返回多个工具调用」（OpenAI 兼容协议的 parallel_tool_calls）。
# 端点不认这个字段时会自动去掉重发，不用手动关
# GA_LLM_PARALLEL_TOOL_CALLS=true
# 各角色可分别绑定模型档位（逗号分隔的 key=value，可选）
# GA_ROLE_MODELS=planner:gpt-4o,developer:gpt-4o,artist:gpt-4o,voice:gpt-4o-mini,tester:gpt-4o

# 本版本没有登录/账号密码：身份就是本机默认用户（无需任何配置）。
# 旧的 GA_AUTH_MODE / GA_BOOTSTRAP_TOKEN 已废弃，留着也不会报错，但不再有任何作用。

# 占位素材：无供应商 key 时是否生成占位素材（true=生成并标记，false=直接失败上报）
PLACEHOLDER_ENABLED=true

# 服务监听
# 端口默认 18888，特意避开 Windows 保留端口段（Hyper-V/WSL/Docker 会把成段端口留给自己，
# 段内 bind 会 WinError 10013；8765 常落在保留段里）。被占用时服务会自动顺延并打印实际端口。
GA_HOST=127.0.0.1
GA_PORT=18888

# 首启是否把 examples/cardgame 拷成示例工作区（打包版会设为 1，开箱就能点开一个项目试）。
# GA_SEED_DEMO=1

# 是否在服务就绪后自动打开浏览器。不设时：打包版（exe）默认打开，源码运行默认不打开
# （dev 会反复重启，每改一行弹一次浏览器没法干活）；显式设 0/1 则以此为准。
# GA_OPEN_BROWSER=1

# ---------- 语音合成（本机 IndexTTS2，配音工具 / 语音工作台 / 对话朗读） ----------
# 空 = 未启用（配音回退占位静音，语音工作台显示未连接）
# 端口统一用 10000 以上（避开 Windows 保留段：7860 在 7781-7880、8860 曾落 Hyper-V 保留段
# 8851-8950）。该端口若被占用/被系统保留，语音服务会自动改绑到 10000 以上的空闲端口。
TTS_BASE_URL=http://127.0.0.1:10189
# 默认音色：填 IndexTTS2 服务端的预设名（推荐），或用 TTS_REF_AUDIO 指定参考音频路径
# TTS_PRESET=沙哑大叔
# TTS_REF_AUDIO=D:/path/to/ref_8s.wav
# 情绪：0=同参考(平) 1=情感参考音频 2=八维向量 3=文字描述情绪
# 只给音色参考音频、不配情绪时模型会用平静语气 → 台词一多就"三句一个调"
TTS_EMO_MODE=0
# TTS_EMO_TEXT=愤怒地质问
# TTS_EMO_WEIGHT=0.65
# TTS_EMO_VECTOR=0.9,0,0,0,0,0,0,0.1
# TTS_EMO_AUDIO=D:/assets/emo_angry_4s.wav
# 单次合成等待上限（秒）：8G 单卡串行，首次含模型加载 30~60 秒
TTS_TIMEOUT_S=600
# 语速 0.5~2.0（>1 慢 <1 快；IndexTTS-2.5 的 duration_factor，2.0 服务自动忽略）
# TTS_SPEED=1.0
# 语言 auto/zh/en/ja/es/ar（auto=服务端按台词判定；IndexTTS-2.5 才生效）
# TTS_LANG=auto
# 是否在界面暴露「音色设计」（需 IndexTTS2 侧装好 VoxCPM2）
GA_TTS_VOICE_DESIGN=true
# 语音服务分发目录（含 runtime\python.exe 与 server.py；当前为 IndexTTS-2.5 平滑升级版）
# TTS_HOME=D:/AI/IndexTTS-2.5-v3

# ---------- GPU 互斥（本地生图 ComfyUI ↔ 本地语音 IndexTTS2 共用一块显卡） ----------
# 出图前自动停语音服务、出音前自动停生图服务，避免两个模型同时驻留导致 OOM。
# 有两块卡各跑一个时可设 false。
GA_GPU_EXCLUSIVE=true
# 停掉对方服务后最多等多少秒让显存真正释放（等端口关闭）
GA_GPU_STOP_TIMEOUT_S=45

# ---------- 高分辨率出图（2K/4K，8G 显存可跑） ----------
# ComfyUI 本身不限分辨率；门槛在 8G 显存。目标像素不超过下面阈值时直接按目标分辨率采样出图
# （全画质，实测 2360x1640≈3.9MP 约 5 分钟）；超过阈值（如 4K≈8MP）会自动先按阈值内基准
# 分辨率采样、再像素放大到目标尺寸（更快，但只是插值放大、不增细节）。
COMFYUI_DIRECT_MAX_MP=4.0
# 超过此像素（百万）的大图改用分块 VAE 解码（防 8G 解码 OOM）；小于等于此值保持原样。
COMFYUI_TILED_MP=1.6
# 分块解码的 tile 尺寸与重叠像素（太小慢、太大费显存；512/64 实测稳定无接缝）
COMFYUI_VAE_TILE=512
COMFYUI_VAE_TILE_OVERLAP=64

# ---------- 运行约束 ----------
# 并行执行的 run 数 = 进程内 worker 数（每个 worker 一次跑一条 run）。
# 单机 lite 是单进程多协程：几条 run 靠 asyncio 并行 + 各自线程里的阻塞调用跑，无需多进程。
# 默认 64：多个会话要能同时开多个对话、互不排队；真正瓶颈是 CPU/GPU/内存与外部端点配额。
GA_MAX_CONCURRENT_RUNS=64
# 同项目允许多条 run 并行改工作区（改动审阅/回滚走写前快照）；false = 同项目串行（写锁）。
GA_SAME_PROJECT_PARALLEL=true
# 单条 shell 命令的等待上限（秒）：编译/单测/lint 这类慢命令用
GA_TOOL_TIMEOUT_S=300
# 单次工具调用的「总超时」兜底（秒）：工具内部各有自己的时限，但万一某个外部调用真正挂死
# （下载/第三方 SDK/半死连接），这层保证 worker 不被一条工具卡死。默认高于最长工具时限。
# 设 0 关闭。
GA_TOOL_HARD_TIMEOUT_S=900
# 同一轮里模型一次最多发多少个工具调用（超出部分不执行、提示分批），防止一轮抽干线程池/连接。
GA_MAX_TOOL_CALLS_PER_ROUND=12
# 递归扫描类命令（Get-ChildItem -Recurse、dir /s、find -r、tree /f …）的单独上限（秒）。
# 整库扫描在十万级文件的目录上能跑几分钟，界面上就是一条「执行中…」挂着不动；
# 扫这么久通常说明范围写错了，所以早点掐断并引导模型用会剪枝的 glob / grep。
# 设为 0 无效（最小 10），且不会超过 GA_TOOL_TIMEOUT_S。
GA_SEARCH_TIMEOUT_S=60

# ---------- AI 联网搜索（web_search / web_fetch 工具，组长角色可用） ----------
# bing = 无 key 抓取必应结果页（默认，国内可达）；ddg = DuckDuckGo HTML 版；
# tavily = 需要 GA_TAVILY_KEY，质量最好。
GA_SEARCH_PROVIDER=bing
# GA_SEARCH_PROVIDER=tavily 时的密钥（https://tavily.com 免费额度）
# GA_TAVILY_KEY=tvly-xxxx
# 单次搜索/抓取超时（秒）
GA_WEB_SEARCH_TIMEOUT_S=15
